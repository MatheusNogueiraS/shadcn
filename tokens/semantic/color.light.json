{
  "bg": {
    "$type": "color",
    "page": {
      "$value": "{color.white}",
      "$description": "Fundo da página"
    },
    "surface": {
      "$value": "{color.white}",
      "$description": "Cartões, menus e janelas"
    },
    "subtle": {
      "$value": "{color.neutral.50}",
      "$description": "Áreas de apoio, como a barra lateral"
    },
    "muted": {
      "$value": "{color.neutral.100}",
      "$description": "Fundos discretos e item em destaque"
    },
    "control": {
      "$value": "{color.neutral.200}",
      "$description": "Trilho e fundo de controles"
    },
    "field": {
      "$value": "{color.neutral.200}",
      "$description": "Campos de formulário",
      "$extensions": {
        "com.designsystem.opacity": "{opacity.50}"
      }
    },
    "divider": {
      "$value": "{color.neutral.200}",
      "$description": "Linhas separadoras"
    },
    "brand": {
      "$value": "{color.orange.500}",
      "$description": "Ação principal"
    },
    "brand-hover": {
      "$value": "{color.orange.600}",
      "$description": "Ação principal com o mouse em cima"
    },
    "brand-secondary": {
      "$value": "{color.purple.900}",
      "$description": "Ação de apoio"
    },
    "brand-secondary-hover": {
      "$value": "{color.purple.950}",
      "$description": "Ação de apoio com o mouse em cima"
    },
    "on-brand": {
      "$value": "{color.white}",
      "$description": "Elemento branco sobre a marca, como o marcador do switch"
    },
    "danger": {
      "$value": "{color.red.600}",
      "$description": "Ação ou estado de erro"
    },
    "danger-subtle": {
      "$value": "{color.red.600}",
      "$description": "Fundo discreto de erro",
      "$extensions": {
        "com.designsystem.opacity": "{opacity.10}"
      }
    },
    "inverse": {
      "$value": "{color.neutral.950}",
      "$description": "Fundo invertido, como o tooltip"
    },
    "overlay": {
      "$value": "{color.black}",
      "$description": "Camada atrás de janelas",
      "$extensions": {
        "com.designsystem.opacity": "{opacity.30}"
      }
    },
    "success": {
      "$value": "{color.green.600}",
      "$description": "Sucesso"
    },
    "success-subtle": {
      "$value": "{color.green.600}",
      "$description": "Fundo discreto de sucesso",
      "$extensions": {
        "com.designsystem.opacity": "{opacity.10}"
      }
    },
    "warning": {
      "$value": "{color.yellow.500}",
      "$description": "Atenção"
    },
    "warning-subtle": {
      "$value": "{color.yellow.500}",
      "$description": "Fundo discreto de atenção",
      "$extensions": {
        "com.designsystem.opacity": "{opacity.10}"
      }
    },
    "info": {
      "$value": "{color.purple.600}",
      "$description": "Informação"
    },
    "info-subtle": {
      "$value": "{color.purple.600}",
      "$description": "Fundo discreto de informação",
      "$extensions": {
        "com.designsystem.opacity": "{opacity.10}"
      }
    }
  },
  "text": {
    "$type": "color",
    "default": {
      "$value": "{color.neutral.950}",
      "$description": "Texto principal"
    },
    "muted": {
      "$value": "{color.neutral.500}",
      "$description": "Texto de apoio"
    },
    "on-muted": {
      "$value": "{color.neutral.900}",
      "$description": "Texto sobre fundo em destaque"
    },
    "on-brand": {
      "$value": "{color.white}",
      "$description": "Texto sobre a marca"
    },
    "brand": {
      "$value": "{color.orange.700}",
      "$description": "Texto e links na cor da marca"
    },
    "danger": {
      "$value": "{color.red.600}",
      "$description": "Texto de erro"
    },
    "inverse": {
      "$value": "{color.white}",
      "$description": "Texto sobre fundo invertido"
    },
    "success": {
      "$value": "{color.green.700}",
      "$description": "Texto de sucesso"
    },
    "warning": {
      "$value": "{color.yellow.700}",
      "$description": "Texto de atenção"
    },
    "info": {
      "$value": "{color.purple.700}",
      "$description": "Texto informativo"
    }
  },
  "stroke": {
    "$type": "color",
    "default": {
      "$value": "{color.neutral.200}",
      "$description": "Borda padrão"
    },
    "field": {
      "$value": "{color.neutral.200}",
      "$description": "Borda de campos"
    },
    "subtle": {
      "$value": "{color.neutral.950}",
      "$description": "Contorno de menus e janelas",
      "$extensions": {
        "com.designsystem.opacity": "{opacity.5}"
      }
    },
    "brand": {
      "$value": "{color.orange.500}",
      "$description": "Borda na cor da marca"
    },
    "surface": {
      "$value": "{color.white}",
      "$description": "Borda com a cor do cartão"
    },
    "page": {
      "$value": "{color.white}",
      "$description": "Borda com a cor da página"
    },
    "focus": {
      "$value": "{color.orange.500}",
      "$description": "Foco"
    },
    "focus-subtle": {
      "$value": "{color.orange.500}",
      "$description": "Anel de foco",
      "$extensions": {
        "com.designsystem.opacity": "{opacity.30}"
      }
    },
    "focus-neutral": {
      "$value": "{color.neutral.400}",
      "$description": "Foco na barra lateral"
    },
    "danger": {
      "$value": "{color.red.600}",
      "$description": "Borda de erro"
    },
    "danger-subtle": {
      "$value": "{color.red.600}",
      "$description": "Anel de erro",
      "$extensions": {
        "com.designsystem.opacity": "{opacity.20}"
      }
    },
    "invalid": {
      "$value": "{color.red.600}",
      "$description": "Campo inválido"
    },
    "success": {
      "$value": "{color.green.600}",
      "$description": "Borda de sucesso"
    },
    "warning": {
      "$value": "{color.yellow.500}",
      "$description": "Borda de atenção"
    },
    "info": {
      "$value": "{color.purple.600}",
      "$description": "Borda informativa"
    }
  },
  "data": {
    "1": {
      "$value": "{color.orange.500}",
      "$description": "Série 1"
    },
    "2": {
      "$value": "{color.purple.900}",
      "$description": "Série 2"
    },
    "3": {
      "$value": "{color.orange.300}",
      "$description": "Série 3"
    },
    "4": {
      "$value": "{color.purple.500}",
      "$description": "Série 4"
    },
    "5": {
      "$value": "{color.orange.700}",
      "$description": "Série 5"
    },
    "$type": "color"
  }
}
